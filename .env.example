# Every setting Spark reads. docs/configuration.md explains each one.
# Values marked (Connectors) can be left empty here and saved later in
# Settings -> Connectors by a workspace owner.

# ---- Used by docker-compose.example.yml only -----------------------------------
# It sets SPARK_DATABASE_URL, SPARK_REDIS_URL and the Janus address itself.
POSTGRES_PASSWORD=change-me-too                     # openssl rand -hex 16

# ---- Core --------------------------------------------------------------------
SPARK_ENV=production
SPARK_BASE_URL=https://spark.example.com           # public address; networks fetch media from here
SPARK_SECRET_KEY=change-me-to-a-long-random-string # openssl rand -hex 32
SPARK_DATABASE_URL=postgresql+asyncpg://spark:spark@db:5432/spark
SPARK_REDIS_URL=redis://redis:6379/0
SPARK_MEDIA_DIR=/data/media
SPARK_MAX_UPLOAD_MB=50
# SPARK_SPA_DIR=frontend/dist                      # the Docker image sets this; leave unset
# SPARK_SPA_BASE=/

# ---- Security ----------------------------------------------------------------
SPARK_SETUP_TOKEN=                                 # asked for when creating the first owner
SPARK_REQUIRE_TWO_FACTOR=false

# ---- Publishing --------------------------------------------------------------
# https://docs.zernio.com/quickstart — keys start with sk_ (Connectors)
SPARK_ZERNIO_API_KEY=
SPARK_ZERNIO_BASE_URL=https://zernio.com/api/v1
# Leave empty: derived from SPARK_SECRET_KEY; Spark registers it from Settings -> Connectors -> Zernio
SPARK_ZERNIO_WEBHOOK_SECRET=
SPARK_PUBLISH_MAX_ATTEMPTS=3
SPARK_METRICS_MAX_CALLS_PER_RUN=200                # requests one analytics run may make
SPARK_FORCE_DRY_RUN=false                          # true = nothing is really published

# ---- AI writing (Connectors) -------------------------------------------------
SPARK_ANTHROPIC_API_KEY=
SPARK_AI_MODEL=claude-opus-5-5
SPARK_AI_EFFORT=medium
SPARK_AI_MODEL_FAST=claude-haiku-5-5

# ---- Images (Connectors) -----------------------------------------------------
SPARK_OPENAI_API_KEY=
SPARK_IMAGE_MODEL=gpt-image-2.6-flare

# ---- Janus agent (the Compose files wire these up) ---------------------------
SPARK_JANUS_MANAGED=false
SPARK_JANUS_BASE_URL=
SPARK_JANUS_API_KEY=                               # docker-compose.example.yml: set a random value
SPARK_JANUS_MODEL=
SPARK_JANUS_EFFORT=medium
SPARK_JANUS_APPROVALS=manual
SPARK_JANUS_SOUL=
SPARK_JANUS_EXTRA_YAML=
SPARK_JANUS_UPDATE_WEBHOOK=
SPARK_JANUS_UPDATE_TOKEN=

# ---- Email (Connectors) ------------------------------------------------------
SPARK_EMAIL_BACKEND=console                        # console | smtp | resend
SPARK_EMAIL_FROM="Spark <hello@example.com>"
SPARK_SMTP_HOST=
SPARK_SMTP_PORT=587
SPARK_SMTP_USER=
SPARK_SMTP_PASSWORD=
SPARK_SMTP_TLS=true
SPARK_RESEND_API_KEY=

# ---- Chat notifications (Connectors); any one destination is enough ---------
SPARK_CHAT_SLACK_WEBHOOK=
SPARK_CHAT_DISCORD_WEBHOOK=
SPARK_CHAT_TEAMS_WEBHOOK=
SPARK_CHAT_TELEGRAM_TOKEN=
SPARK_CHAT_TELEGRAM_CHAT_ID=
SPARK_CHAT_ON_APPROVAL=true
SPARK_CHAT_ON_FAILED=true
SPARK_CHAT_ON_REVIEW=true
SPARK_CHAT_ON_PUBLISHED=false
SPARK_CHAT_ON_CHANNEL=true

# ---- Direct network apps (advanced, only without Zernio) --------------------
# Redirect address for each: {SPARK_BASE_URL}/accounts/callback/<platform>
SPARK_X_CLIENT_ID=
SPARK_X_CLIENT_SECRET=
SPARK_LINKEDIN_CLIENT_ID=
SPARK_LINKEDIN_CLIENT_SECRET=
SPARK_META_APP_ID=                                 # Facebook Pages + Instagram
SPARK_META_APP_SECRET=
SPARK_THREADS_APP_ID=
SPARK_THREADS_APP_SECRET=
SPARK_PINTEREST_CLIENT_ID=
SPARK_PINTEREST_CLIENT_SECRET=
SPARK_TIKTOK_CLIENT_KEY=
SPARK_TIKTOK_CLIENT_SECRET=
SPARK_GOOGLE_CLIENT_ID=                            # YouTube
SPARK_GOOGLE_CLIENT_SECRET=
