# ---- Core ------------------------------------------------------------------
SPARK_ENV=production
SPARK_BASE_URL=https://spark.example.com          # public URL; platforms fetch media from here
SPARK_SECRET_KEY=change-me-to-a-long-random-string # signs sessions, encrypts tokens
SPARK_DATABASE_URL=postgresql+asyncpg://spark:spark@db:5432/spark
SPARK_REDIS_URL=redis://redis:6379/0
SPARK_MEDIA_DIR=/data/media
SPARK_MAX_UPLOAD_MB=50
SPARK_FORCE_DRY_RUN=false                          # true = no real publishing, fake accounts

# ---- AI (Claude) ----------------------------------------------------------------
SPARK_ANTHROPIC_API_KEY=
SPARK_AI_MODEL=claude-opus-5-5
SPARK_AI_EFFORT=medium

# ---- Zernio: one key connects X, LinkedIn, Meta, TikTok, YouTube, ... ---------
# https://docs.zernio.com/quickstart — API keys start with sk_
SPARK_ZERNIO_API_KEY=

# ---- Email -------------------------------------------------------------------------
SPARK_EMAIL_BACKEND=console                        # console | smtp | resend
SPARK_EMAIL_FROM="Spark <hello@example.com>"
SPARK_SMTP_HOST=
SPARK_SMTP_PORT=587
SPARK_SMTP_USER=
SPARK_SMTP_PASSWORD=
SPARK_SMTP_TLS=true
SPARK_RESEND_API_KEY=

# ---- Direct platform apps (optional if you use Zernio) ----------------------
# Redirect URI for each: {SPARK_BASE_URL}/accounts/callback/<platform>
SPARK_X_CLIENT_ID=
SPARK_X_CLIENT_SECRET=
SPARK_LINKEDIN_CLIENT_ID=
SPARK_LINKEDIN_CLIENT_SECRET=
SPARK_META_APP_ID=                                 # Facebook Pages + Instagram
SPARK_META_APP_SECRET=
SPARK_THREADS_APP_ID=
SPARK_THREADS_APP_SECRET=
SPARK_PINTEREST_CLIENT_ID=
SPARK_PINTEREST_CLIENT_SECRET=
SPARK_TIKTOK_CLIENT_KEY=
SPARK_TIKTOK_CLIENT_SECRET=
SPARK_GOOGLE_CLIENT_ID=                            # YouTube
SPARK_GOOGLE_CLIENT_SECRET=
